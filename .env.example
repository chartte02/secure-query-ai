# SecureQuery AI 本地开发环境变量示例。
# 需要时复制为 .env 再修改；.env 已被 Git 忽略，任何真实凭据都不得提交。

# ---- 成员 A：AI SQL 服务（默认 Mock，无需 Ollama）----
SECUREQUERY_PROVIDER=mock
SECUREQUERY_DEMO_MODE=true
# 实验直连执行器：仅用于本地 Demo 观察 B 的数据库控制。
# 它不是 C 的策略网关；开启后 /api/v1/queries 会直接以只读角色执行候选 SQL。
SECUREQUERY_LAB_GATEWAY=false
# C 正式网关：需要 requirements-database.lock 和本地 hardened PostgreSQL。
SECUREQUERY_FORMAL_GATEWAY=false
SECUREQUERY_MODEL=qwen2.5-coder:7b
SECUREQUERY_OLLAMA_BASE_URL=http://127.0.0.1:11435
SECUREQUERY_CONNECT_TIMEOUT_SECONDS=2
SECUREQUERY_READ_TIMEOUT_SECONDS=60
SECUREQUERY_TOTAL_TIMEOUT_SECONDS=90
SECUREQUERY_MAX_PROVIDER_RESPONSE_BYTES=65536
SECUREQUERY_MAX_RAW_OUTPUT_CHARS=8192
SECUREQUERY_MAX_CONCURRENCY=1

# ---- 成员 B：PostgreSQL 实验室（scripts/init_db.py 在 .env 缺失时生成随机密钥）----
# 不要直接复制下面的占位值；任何凭据都不会交给模型。
SQ_ADMIN_PASSWORD=replace-with-random-local-secret
SQ_ROLE_SECRET=replace-with-another-random-local-secret
SQ_INSTALLATION_ID=replace-with-generated-uuid
# 2026-10-28 实测固定的镜像 digest；升级时需显式覆盖。
SQ_POSTGRES_IMAGE=postgres:17@sha256:31ba9c94a03ada9988f2bb493a22a75eef3a185884533e5cdbcd498ea835b08f
